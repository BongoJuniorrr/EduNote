# Configure providers here or in Settings after startup. Never commit .env.
LLM_COMPLETION_TRANSPORT=stream
LLM_BINDING=openai
LLM_HOST=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_BINDING=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_TOKENS=512
EMBEDDING_DEVICE=cpu
# Download local embedding weights on first use instead of delaying setup.
EMBEDDING_PREWARM=false
EMBEDDING_API_KEY=
EMBEDDING_HOST=
TTS_BINDING=openai
TTS_MODEL=tts-1
TTS_URL=https://api.openai.com/v1
TTS_API_KEY=
SEARCH_PROVIDER=jina
SEARCH_API_KEY=
FRONTEND_PORT=3782
# Keep local-only; terminate HTTPS in your reverse proxy before exposing.
EDUNOTE_BIND_ADDRESS=127.0.0.1
EDUNOTE_RATE_LIMIT=120
# Generated by start.sh if absent. No default database password is shipped.
PRESENTON_POSTGRES_PASSWORD=
PRESENTON_OPENAI_BASE_URL=
PRESENTON_OPENAI_API_KEY=
PRESENTON_OPENAI_MODEL=

# Optional; downloads a semantic icon model on first icon query.
PRESENTON_SEMANTIC_ICONS=false
